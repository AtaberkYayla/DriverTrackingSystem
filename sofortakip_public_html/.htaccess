# Flutter web build dosya adlari icerik degisince degismiyor (main.dart.js,
# flutter_bootstrap.js vb. hash almiyor), bu yuzden tarayici/CDN bunlari
# agresif onbelleklerse yeni deploy sonrasinda kullanicilar eski kodu gormeye
# devam eder. Cozum: uygulamayi ayaga kaldiran "giris noktasi" dosyalarini
# hicbir zaman onbellekten degil, her zaman sunucudan tazelet; degismesi
# nadir olan statik varliklari (icons, canvaskit, favicon) ise normal
# onbellekle.
<IfModule mod_headers.c>
  # Apache eslesen her <FilesMatch> icin Header set'i sirayla uygular ve
  # ayni header'i sonraki blok yine "set" ederse oncekini ezer - bu yuzden
  # once genel/gevsek kural, sonra ozel/siki (no-cache) kural gelmeli.
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?|ttf|json|wasm)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  <FilesMatch "^(index\.html|version\.json|manifest\.json|flutter_bootstrap\.js|flutter\.js|flutter_service_worker\.js|main\.dart\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"
</IfModule>
