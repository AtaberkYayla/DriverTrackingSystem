{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "driver_app - Local XAMPP",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "packages/driver_app",
      "args": ["--dart-define=API_BASE_URL=http://localhost/backend"]
    },
    {
      "name": "admin_web - Local XAMPP",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "packages/admin_web",
      "deviceId": "chrome",
      "args": ["--dart-define=API_BASE_URL=http://localhost/backend"]
    },
    {
      "name": "driver_app - env/api.json (dikkat: gerçek deploy adresi)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "packages/driver_app",
      "args": ["--dart-define-from-file=env/api.json"]
    },
    {
      "name": "admin_web - env/api.json (dikkat: gerçek deploy adresi)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "packages/admin_web",
      "deviceId": "chrome",
      "args": ["--dart-define-from-file=env/api.json"]
    }
  ]
}
